#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
#include "fluid_sph_common.glsl"
// Neighbour search, 1: particles per bin (counts start at zero).

layout(set = 0, binding = 0, std430) readonly buffer State { vec4 data[]; } state;
layout(set = 0, binding = 1, std430) buffer Counts { uint data[]; } counts;
layout(push_constant) uniform Params { SphCommon c; } params;

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (outside(c, params.c.side)) return;
    const vec2 p = state.data[cellIndex(c, params.c.side)].xy;
    atomicAdd(counts.data[binIndex(binOf(p, params.c.bins), params.c.bins)], 1u);
}
