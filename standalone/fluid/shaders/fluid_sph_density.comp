#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
#include "fluid_sph_common.glsl"
// Each particle's density and pressure, summed over its neighbours (itself included). Pressure compares
// the density with the initial lattice's at the same point, so particles at a wall, short of neighbours,
// are at rest there too, and it is signed: the tank is full, and resists being stretched as much as
// being squeezed.

layout(set = 0, binding = 0, std430) readonly buffer State { vec4 data[]; } state;
layout(set = 0, binding = 1, std430) readonly buffer Ranges { uvec2 data[]; } ranges;
layout(set = 0, binding = 2, std430) readonly buffer Indices { uint data[]; } indices;
layout(set = 0, binding = 3, std430) writeonly buffer Pressure { vec2 data[]; } densityPressure;
layout(push_constant) uniform Params { SphCommon c; } params;

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (outside(c, params.c.side)) return;
    const uint i = cellIndex(c, params.c.side);
    const vec2 p = state.data[i].xy;
    const ivec2 home = binOf(p, params.c.bins);
    float density = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 b = home + ivec2(dx, dy);
            if (outside(b, params.c.bins)) continue;
            const uvec2 range = ranges.data[binIndex(b, params.c.bins)];
            for (uint k = range.x; k < range.x + range.y; ++k) {
                const vec2 r = p - state.data[indices.data[k]].xy;
                density += params.c.mass * poly6(dot(r, r), params.c.h);
            }
        }
    }
    const float rest = latticeDensity(p, params.c.h, params.c.side, params.c.mass);
    const float pressure = params.c.stiffness * (density / rest - 1.0);
    densityPressure.data[i] = vec2(density, pressure);
}
