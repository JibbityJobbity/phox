#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
// Stable fluids, step 4: one Jacobi iteration of the pressure Poisson equation, laplacian(p) = divergence,
// with zero normal pressure gradient at the walls (a neighbour outside takes the cell's own pressure).

layout(set = 0, binding = 0, std430) readonly buffer PressureIn { float data[]; } pressureIn;
layout(set = 0, binding = 1, std430) readonly buffer Divergence { float data[]; } divergence;
layout(set = 0, binding = 2, std430) writeonly buffer PressureOut { float data[]; } pressureOut;
layout(push_constant) uniform Params { uint n; } params;

float at(ivec2 c, float own) { return outside(c, params.n) ? own : pressureIn.data[cellIndex(c, params.n)]; }

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (outside(c, params.n)) return;
    const uint i = cellIndex(c, params.n);
    const float own = pressureIn.data[i];
    const float h = 1.0 / float(params.n);
    const float sum = at(c + ivec2(1, 0), own) + at(c - ivec2(1, 0), own) + at(c + ivec2(0, 1), own) + at(c - ivec2(0, 1), own);
    pressureOut.data[i] = 0.25 * (sum - h * h * divergence.data[i]);
}
