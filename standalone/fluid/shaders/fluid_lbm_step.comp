#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
#include "fluid_lbm_common.glsl"
// Lattice Boltzmann, one step: stream (pull from the neighbours, bouncing back off the walls), then BGK
// collision with the splats as a body force (velocity shift), and the macroscopic density and velocity.
// Mass is conserved: bounce-back returns what hits a wall, and the equilibrium has the cell's density.

layout(set = 0, binding = 0, std430) readonly buffer PopulationsIn { float data[]; } fin;
layout(set = 0, binding = 1, std430) writeonly buffer PopulationsOut { float data[]; } fout;
layout(set = 0, binding = 2, std430) writeonly buffer Density { float data[]; } density;
layout(set = 0, binding = 3, std430) writeonly buffer Velocity { vec2 data[]; } velocity;
layout(push_constant) uniform Params {
    uint n;
    float tau;        // relaxation time; viscosity (tau - 0.5) / 3
    uint splatCount;
    float forceScale; // splat force to lattice units
    Splat splats[kMaxSplats];
} params;

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    const uint n = params.n;
    if (outside(c, n)) return;
    const uint cell = cellIndex(c, n);
    const uint stride = n * n;

    float f[9];
    float rho = 0.0;
    vec2 momentum = vec2(0.0);
    for (int i = 0; i < 9; ++i) {
        const ivec2 from = c - kE[i];
        // A population that would come from a wall is the one this cell sent towards it, reflected.
        f[i] = outside(from, n) ? fin.data[kOpposite[i] * stride + cell] : fin.data[i * stride + cellIndex(from, n)];
        rho += f[i];
        momentum += f[i] * vec2(kE[i]);
    }
    vec2 force = vec2(0.0);
    const vec2 p = cellCentre(c, n);
    for (uint s = 0; s < min(params.splatCount, kMaxSplats); ++s) {
        force += params.forceScale * params.splats[s].positionForce.zw * splatWeight(params.splats[s], p);
    }
    const vec2 u = momentum / rho;
    const vec2 uEquilibrium = u + params.tau * force / rho;
    for (int i = 0; i < 9; ++i) {
        fout.data[i * stride + cell] = f[i] - (f[i] - equilibrium(i, rho, uEquilibrium)) / params.tau;
    }
    density.data[cell] = rho;
    velocity.data[cell] = u + 0.5 * force / rho;
}
