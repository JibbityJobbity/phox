#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
#include "fluid_sph_common.glsl"
// The particles as fields on the n x n grid, gathered from the bins around each cell's centre with a wider
// kernel than the physics (smoother to look at): density sum(m W) relative to what the initial lattice of
// particles has at the same point (so a tank at rest is 1 everywhere, its edges included, and both
// compression and rarefaction show), and velocity weighted by the same kernel (zero where no particle
// reaches). Keep in step with sphFieldError() in the fluid tests.

layout(set = 0, binding = 0, std430) readonly buffer State { vec4 data[]; } state;
layout(set = 0, binding = 1, std430) readonly buffer Ranges { uvec2 data[]; } ranges;
layout(set = 0, binding = 2, std430) readonly buffer Indices { uint data[]; } indices;
layout(set = 0, binding = 3, std430) writeonly buffer Density { float data[]; } density;
layout(set = 0, binding = 4, std430) writeonly buffer Velocity { vec2 data[]; } velocity;
layout(push_constant) uniform Params {
    SphCommon c;
    uint n;
    float radius;
    float unused;
    uint reach; // bins either side
} params;

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (outside(c, params.n)) return;
    const vec2 x = cellCentre(c, params.n);
    const ivec2 home = binOf(x, params.c.bins);
    float rho = 0.0;
    vec2 momentum = vec2(0.0);
    const int reach = int(params.reach);
    for (int dy = -reach; dy <= reach; ++dy) {
        for (int dx = -reach; dx <= reach; ++dx) {
            const ivec2 b = home + ivec2(dx, dy);
            if (outside(b, params.c.bins)) continue;
            const uvec2 range = ranges.data[binIndex(b, params.c.bins)];
            for (uint k = range.x; k < range.x + range.y; ++k) {
                const vec4 particle = state.data[indices.data[k]];
                const vec2 r = x - particle.xy;
                const float w = params.c.mass * poly6(dot(r, r), params.radius);
                rho += w;
                momentum += w * particle.zw;
            }
        }
    }
    const float lattice = latticeDensity(x, params.radius, params.c.side, params.c.mass);
    const uint cell = cellIndex(c, params.n);
    density.data[cell] = lattice > 0.0 ? rho / lattice : 1.0;
    velocity.data[cell] = rho > 0.0 ? momentum / rho : vec2(0.0);
}
