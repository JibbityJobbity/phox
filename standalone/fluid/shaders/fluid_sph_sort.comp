#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
#include "fluid_sph_common.glsl"
// Neighbour search, 4: each bin's slice sorted by particle index, so that every sum over neighbours runs in
// the same order on every run and every queue (the atomics' order is not reproducible). Bins hold a few
// particles, so an insertion sort does.

layout(set = 0, binding = 0, std430) readonly buffer Ranges { uvec2 data[]; } ranges;
layout(set = 0, binding = 1, std430) buffer Indices { uint data[]; } indices;
layout(push_constant) uniform Params { SphCommon c; } params;

void main() {
    const ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    if (outside(b, params.c.bins)) return;
    const uvec2 range = ranges.data[binIndex(b, params.c.bins)];
    for (uint i = range.x + 1; i < range.x + range.y; ++i) {
        const uint value = indices.data[i];
        uint j = i;
        while (j > range.x && indices.data[j - 1] > value) {
            indices.data[j] = indices.data[j - 1];
            --j;
        }
        indices.data[j] = value;
    }
}
