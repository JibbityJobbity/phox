#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_common.glsl"
#include "fluid_lbm_common.glsl"
// Lattice Boltzmann: fluid at rest with density 1, f_i = w_i. Populations are stored one direction after
// another: f[i * n * n + cell].

layout(set = 0, binding = 0, std430) writeonly buffer Populations { float data[]; } f;
layout(push_constant) uniform Params { uint n; } params;

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (outside(c, params.n)) return;
    const uint cell = cellIndex(c, params.n);
    const uint stride = params.n * params.n;
    for (int i = 0; i < 9; ++i) f.data[i * stride + cell] = kW[i];
}
